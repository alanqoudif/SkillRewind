---
import { githubUrl, docs, status, siteTitle } from '../data/site';
---
<footer class="border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
      <div>
        <div class="mb-3 flex items-center gap-2 font-semibold text-ink">
          <svg width="20" height="20" viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="12" fill="#121317"/>
            <circle cx="16" cy="16" r="5" fill="#5b8dee"/>
            <circle cx="16" cy="48" r="5" fill="#5b8dee"/>
            <circle cx="48" cy="32" r="5" fill="#3ec776"/>
            <path d="M16 16 L16 48" stroke="#5b8dee" stroke-width="3" fill="none"/>
            <path d="M16 32 L40 32" stroke="#5b8dee" stroke-width="3" fill="none"/>
          </svg>
          {siteTitle}
        </div>
        <p class="text-sm text-muted">Research &amp; Integration Preview · {status.license}</p>
      </div>

      <div>
        <h2 class="mb-3 text-sm font-semibold text-ink">Project</h2>
        <ul class="space-y-2 text-sm text-muted">
          <li><a class="hover:text-ink" href={githubUrl}>GitHub</a></li>
          <li><a class="hover:text-ink" href={docs.researchProposal}>Research proposal</a></li>
          <li><a class="hover:text-ink" href={docs.status}>Status</a></li>
          <li><a class="hover:text-ink" href={docs.license}>License</a></li>
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-sm font-semibold text-ink">Specification</h2>
        <ul class="space-y-2 text-sm text-muted">
          <li><a class="hover:text-ink" href={docs.integrationContract}>Integration contract</a></li>
          <li><a class="hover:text-ink" href={docs.apiStability}>API stability</a></li>
          <li><a class="hover:text-ink" href={docs.openapi}>OpenAPI (v1)</a></li>
          <li><a class="hover:text-ink" href={docs.eventContract}>Event contract</a></li>
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-sm font-semibold text-ink">Security</h2>
        <ul class="space-y-2 text-sm text-muted">
          <li><a class="hover:text-ink" href={docs.threatModel}>Threat model</a></li>
          <li><a class="hover:text-ink" href={docs.security}>Vulnerability reporting</a></li>
          <li><a class="hover:text-ink" href={docs.releaseReadiness}>Release readiness</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-border pt-6 text-xs text-muted sm:flex-row sm:items-center">
      <p>Apache License 2.0. Copyright Faisal Ali Said Al-Anqoudi / Nuqta Technologies.</p>
      <p>Self-hosted · Open source · Not a hosted SaaS.</p>
    </div>
  </div>
</footer>
