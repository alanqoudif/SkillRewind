{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillrewind.dev/spec/revocation-attestation.schema.json",
  "title": "SkillRewind Revocation Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "mode",
    "started_at",
    "completed_at",
    "revoked_roots",
    "recorded_closure",
    "inferred_candidates",
    "replay_confirmed",
    "rejected",
    "quarantined",
    "rebuilt",
    "unresolved",
    "verification",
    "bounded_claims"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["recorded-only", "strict", "balanced", "forensic"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "tool_version": {"type": "string"},
    "revocation_reason": {"type": "string"},
    "revoked_roots": {"$ref": "#/$defs/artifactList"},
    "replayability_boundary": {
      "type": "object",
      "properties": {
        "description": {"type": "string"},
        "model_identifiers": {"type": "array", "items": {"type": "string"}},
        "environment_digests": {"type": "array", "items": {"type": "string"}},
        "known_gaps": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "recorded_closure": {"$ref": "#/$defs/artifactList"},
    "inferred_candidates": {"$ref": "#/$defs/edgeList"},
    "replay_confirmed": {"$ref": "#/$defs/edgeList"},
    "rejected": {"$ref": "#/$defs/edgeList"},
    "quarantined": {"$ref": "#/$defs/artifactList"},
    "rebuilt": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["old_artifact_id", "new_artifact_id", "verification_status"],
        "properties": {
          "old_artifact_id": {"type": "string"},
          "new_artifact_id": {"type": "string"},
          "verification_status": {"enum": ["passed", "failed", "partial"]},
          "report_digest": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "reason"],
        "properties": {
          "artifact_id": {"type": "string"},
          "reason": {"type": "string"},
          "severity": {"enum": ["low", "medium", "high", "critical"]}
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "suite_ids", "target_behavior_observed"],
      "properties": {
        "status": {"enum": ["passed", "failed", "partial", "not-run"]},
        "suite_ids": {"type": "array", "items": {"type": "string"}},
        "target_behavior_observed": {"type": ["boolean", "null"]},
        "clean_utility_retained": {"type": "number", "minimum": 0},
        "reports": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replay_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "wall_clock_seconds": {"type": "number", "minimum": 0}
      }
    },
    "bounded_claims": {"type": "array", "items": {"type": "string"}},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {"type": "string"},
        "key_id": {"type": "string"},
        "value": {"type": "string"}
      }
    }
  },
  "$defs": {
    "artifactList": {"type": "array", "items": {"type": "string"}},
    "edgeList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_reference": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  }
}
